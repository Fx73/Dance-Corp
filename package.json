{
  "name": "DanceCorp",
  "version": "1.1.6",
  "description": "A StepMania-style rhythm game engine, rebuilt from scratch for the web browser and the desktop.",
  "author": "Fx",
  "homepage": "https://dance-corp.web.app",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage",
    "lint": "ng lint",
    "ionic-build-prod": "ionic build --prod",
    "clean": "node -e \"const fs=require('fs');['node_modules','package-lock.json'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "reinstall": "npm run clean && npm install"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/youtube-player": "^22.2.3",
    "@ionic/angular": "^9.0.8",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^13.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/youtube": "^0.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "browserslist": [
    "Chrome >=119",
    "ChromeAndroid >=119",
    "Firefox >=119",
    "Edge >=119",
